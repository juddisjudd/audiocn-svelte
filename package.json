{
	"name": "audiocn-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm registry:build && vite build && node scripts/search/postbuild.mjs && node scripts/og/generate.mjs",
		"preview": "vite preview",
		"search:index": "pagefind --site build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"docs:convert": "node scripts/convert-mdx.mjs",
		"registry:build": "shadcn-svelte registry build",
		"test:install": "node scripts/test-install.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@takumi-rs/core": "^2.14.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/hast": "^3.0.5",
		"@types/node": "^24",
		"@types/prismjs": "^1.26.6",
		"bits-ui": "^2.19.4",
		"cn": "^0.4.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.1",
		"katex": "^0.16.47",
		"mdsvex": "^0.12.8",
		"mermaid": "^12.1.0",
		"mode-watcher": "^1.1.0",
		"pagefind": "^1.5.2",
		"phosphor-svelte": "^3.1.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prism-svelte": "^0.5.0",
		"prismjs": "^1.30.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex-svelte": "^1.2.0",
		"rehype-slug": "^6.0.0",
		"remark-math": "^3.0.1",
		"shadcn-svelte": "^1.7.0",
		"sitemap": "^9.0.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#test/*": "./test/*"
	},
	"dependencies": {
		"runed": "^0.37.1"
	}
}
